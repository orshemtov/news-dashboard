# News Dashboard — Docker Deployment
# Copy to .env.docker and fill in values.
# Used by: docker compose --env-file .env.docker up -d
#
# DATABASE_URL is NOT set here — docker-compose.yml assembles it from
# POSTGRES_* vars so there is no duplication.

# Frontend nginx proxy target
# Override if the backend is not reachable as "backend:8000" (e.g. non-Compose deployments)
BACKEND_URL=http://backend:8000

# Postgres — configures the postgres container and is used by
# docker-compose.yml to assemble DATABASE_URL for the backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=news_dashboard

# AI - Embeddings (local sentence-transformers, baked into backend image)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_WINDOW_HOURS=24

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Ingestion
INITIAL_BACKFILL_HOURS=24
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=300

# Media
MEDIA_STORAGE_PATH=media
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_DOWNLOAD_ENABLED=true
