{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--output-dir", ".opencode/screenshots"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx", "-y", "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/news_dashboard"
      ],
      "enabled": true
    },
    "kafka": {
      "type": "local",
      "command": ["kafka-mcp-server"],
      "environment": {
        "KAFKA_BROKERS": "localhost:9092",
        "KAFKA_CLIENT_ID": "opencode-mcp",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "instructions": ["AGENTS.md", "IMPROVE.md"],
  "formatter": {
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py"]
    },
    "prettier": {
      "command": ["pnpm", "--dir", "frontend", "exec", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".css", ".json"]
    }
  }
}
