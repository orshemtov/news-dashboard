{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--output-dir", ".opencode/screenshots"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx", "-y", "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/news_dashboard"
      ],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md", "IMPROVE.md"],
  "formatter": {
    "ruff": { "command": ["uv", "run", "ruff", "format", "$FILE"], "extensions": [".py"] },
    "prettier": { "command": ["pnpm", "--dir", "frontend", "exec", "prettier", "--write", "$FILE"], "extensions": [".ts", ".tsx", ".js", ".jsx", ".css", ".json"] }
  }
}
