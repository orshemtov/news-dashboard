# Frontend environment variables
# Copy to .env.local for local overrides (Vite loads this automatically).
#
# VITE_API_BASE_URL controls where the frontend sends API requests.
# Leave unset (or set to /api) when nginx proxies /api to the backend
# on the same origin (default Docker Compose setup).
# Set to an absolute URL when the backend is on a different host/port,
# e.g. when running the frontend standalone or behind a different reverse proxy.
#
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
