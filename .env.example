# News Dashboard
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_dashboard

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=news_dashboard

# AI - LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI - Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_WINDOW_HOURS=24

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=news_dashboard

# Ingestion
TELEGRAM_POLL_INTERVAL_SECONDS=60
INITIAL_BACKFILL_HOURS=24
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=300

# Media
MEDIA_STORAGE_PATH=media
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_DOWNLOAD_ENABLED=true
