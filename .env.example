# News Dashboard
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_dashboard

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=news_dashboard

# AI - Embeddings (local sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_WINDOW_HOURS=24

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=news_dashboard

# Ingestion
INITIAL_BACKFILL_HOURS=24
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=300

# Media
MEDIA_STORAGE_PATH=media
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_DOWNLOAD_ENABLED=true
